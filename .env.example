# Verse-to-Song Learning System Configuration

# MongoDB Connection
# Local: mongodb://localhost:27017/dcgame
# Production: mongodb+srv://user:password@cluster.mongodb.net/dcgame
MONGODB_URI=mongodb://localhost:27017/dcgame

# Suno API Key (via kie.ai gateway)
# Get from: https://kie.ai
KIE_API_KEY=your-api-key-here

# OpenRouter API Key (for AI devotional/sermon generation)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key-here

# Optional: AI model for sermon generation (default: openrouter/auto)
# SERMON_MODEL=anthropic/claude-sonnet-4-5-20250929

# Optional: Server Port (default: 3500)
PORT=3500
